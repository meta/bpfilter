#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only

"""Run one prebuilt bpfilter e2e test in a virtme-ng guest."""

import argparse
from datetime import datetime
from pathlib import Path
import os
import re
import shlex
import shutil
import subprocess
import sys


REPO = Path(__file__).resolve().parents[2]


def run(*command):
    print("+ " + shlex.join(str(arg) for arg in command), flush=True)
    subprocess.run(command, check=True)


def mount_filesystem(path, filesystem):
    current = subprocess.run(
        ["findmnt", "-rn", "-M", path, "-o", "FSTYPE"],
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    if current == filesystem:
        return
    if current:
        raise RuntimeError(f"{path} contains {current}, expected {filesystem}")

    Path(path).mkdir(parents=True, exist_ok=True)

    run("mount", "-t", filesystem, filesystem, path)


def guest(build, test):
    # Only prepare filesystems inside the intended guest.
    if not any(
        word.startswith("virtme.") for word in Path("/proc/cmdline").read_text().split()
    ):
        raise RuntimeError("the guest command must run inside virtme-ng")

    if os.geteuid() != 0:
        raise RuntimeError("the guest command requires root")

    print(f"Kernel: {os.uname().release}", flush=True)
    mount_filesystem("/sys/fs/bpf", "bpf")
    mount_filesystem("/sys/fs/cgroup", "cgroup2")

    # The host fixture already built the binaries. Select exactly one native test
    # and suppress its build fixture, so nothing compiles inside the VM.
    run(
        "ctest",
        "--test-dir",
        build,
        "-L",
        "^e2e$",
        "-R",
        "^" + re.escape(test) + "$",
        "-FA",
        r"^build\.e2e$",
        "-j1",
        "--no-tests=error",
        "--output-on-failure",
    )


def positive_int(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("the value must be positive")
    return number


def main():
    # Internal entry point passed through vng --exec.
    if len(sys.argv) > 1 and sys.argv[1] == "--guest":
        if len(sys.argv) != 4:
            raise RuntimeError("invalid guest arguments")
        guest(Path(sys.argv[2]), sys.argv[3])
        return 0

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--kernel",
        required=True,
        type=Path,
        help="built kernel directory containing vmlinux",
    )
    parser.add_argument(
        "--test", required=True, help="prebuilt native e2e test to run by exact name"
    )
    parser.add_argument(
        "--boot-argument",
        action="append",
        default=[],
        help="extra kernel command-line argument (repeatable)",
    )
    parser.add_argument("--memory", default="1G", help="guest RAM (default: 1G)")
    parser.add_argument("--cpus", type=positive_int, default=1)
    parser.add_argument(
        "--build-dir",
        type=Path,
        default=Path("build"),
        help="bpfilter build directory, relative to the repository",
    )
    parser.add_argument(
        "--log-dir",
        type=Path,
        help="host log directory (default: build-dir/vng-logs/timestamp)",
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="print commands without booting"
    )
    args = parser.parse_args()

    if not shutil.which("vng"):
        parser.error("vng is missing; install virtme-ng")

    kernel = args.kernel.resolve()
    if not kernel.is_dir() or not (kernel / "vmlinux").is_file():
        parser.error("--kernel must name a built kernel directory containing vmlinux")

    build = (REPO / args.build_dir).resolve()
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    logs = args.log_dir.resolve() if args.log_dir else build / "vng-logs" / stamp

    command = [
        "vng",
        "--run",
        str(kernel),
        "--user",
        "root",
        "--memory",
        args.memory,
        "--cpus",
        str(args.cpus),
        "--cwd",
        str(REPO),
    ]

    if args.boot_argument:
        command += ["--append", " ".join(args.boot_argument)]

    guest_command = [
        "python3",
        str(Path(__file__).resolve()),
        "--guest",
        str(build),
        args.test,
    ]

    command += ["--exec", shlex.join(guest_command)]

    print("+ " + shlex.join(command), flush=True)

    if args.dry_run:
        return 0

    logs.mkdir(parents=True, exist_ok=True)
    log = logs / "guest.log"
    print(f"Host log: {log}", flush=True)

    # The guest uses vng's filesystem overlays. Only these logs persist.
    with log.open("w") as output:
        with subprocess.Popen(
            command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
        ) as process:
            for line in process.stdout:
                print(line, end="", flush=True)
                output.write(line)
            result = process.wait()
    return result if result >= 0 else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(2)
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode if error.returncode > 0 else 1)
